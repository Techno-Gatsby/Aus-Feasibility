# Copy to pipeline/.env and fill in. pipeline/.env is gitignored.
# A real environment variable of the same name takes precedence over this file.

# Apify API token - https://console.apify.com/account/integrations
APIFY_TOKEN=

# Apify actor that scrapes realestate.com.au sold listings.
# Set this once you have picked an actor from the Apify store.
APIFY_REA_ACTOR=

# Optional: override the budget caps in pipeline/rea.config.json
# REA_MONTHLY_ITEM_BUDGET=10000
# REA_MAX_ITEMS_PER_RUN=2000
# REA_MAX_SUBURBS_PER_RUN=40
