# Copy to web/.env.local for local dev, or set via `vercel env add`.
# NEVER commit real values.

# Required — the app returns 503 without these (fails closed by design)
LAND_INTEL_PIN=2911
LAND_INTEL_SECRET=generate-with-openssl-rand-hex-32

# Optional — features degrade to a clear "not configured" message without them
# Free key: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
# Google Cloud: enable Maps Embed API + Street View Static API.
# MUST be HTTP-referrer restricted to your domain.
GOOGLE_MAPS_API_KEY=
